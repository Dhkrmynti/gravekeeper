# Robinhood Chain RPC
RPC_URL=https://rpc.robinhood.org

# Private Key wallet pembuat token (creator)
CREATOR_PRIVATE_KEY=your_private_key_here

# Alamat Token & Curve yang didapat saat launch di Pons
TOKEN_ADDRESS=0x...
CURVE_ADDRESS=0x...

# Ambang batas minimal fee (ETH) sebelum bot mengklaim dan melakukan buyback & burn
CLAIM_THRESHOLD_ETH=0.01

# Interval pengecekan (detik)
POLL_INTERVAL_SECONDS=10

# ADMIN SECRET untuk /memex (wajib, minimal 16 karakter). Tanpa ini semua perubahan admin ditolak.
# Buat yang acak, misalnya: openssl rand -hex 24
ADMIN_SECRET=""

# Slippage for buybacks, in bps (500 = 5%). A buy that would return less reverts and spends no gas.
BUY_SLIPPAGE_BPS=500
