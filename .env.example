# PONS V2 TOKEN CONFIGURATION (Robinhood Chain ID: 4663)
VITE_TOKEN_NAME="Gravekeeper"
VITE_TOKEN_SYMBOL="GRAVE"
# Isi dengan CA $GRAVE setelah launch di Pons (atau set lewat /memex)
VITE_TOKEN_ADDRESS=""

# 1. KONTRAK BONDING CURVE (Swap sebelum token bermigrasi / ungraduated)
# Kosongkan jika ingin auto-detect dari token via token.curve()
VITE_CURVE_ADDRESS=""

# 2. KONTRAK UNISWAP (Swap sesudah token bermigrasi / graduated)
# Default router resmi Robinhood Chain: Uniswap v4 Universal Router
VITE_UNISWAP_ROUTER_ADDRESS="0x8876789976dEcBfCbBbe364623C63652db8C0904"

# CREATOR & SIKLUS ENGINE
VITE_CREATOR_ADDRESS=""
VITE_CLAIM_THRESHOLD_ETH="0.01"
VITE_CYCLE_INTERVAL_SECONDS="300"
VITE_RPC_URL="https://rpc.mainnet.chain.robinhood.com"

# WALLET OPERATOR BOT (Untuk eksekusi background 24/7 di VPS/PC)
CREATOR_PRIVATE_KEY=""
PORT=5015
WEB_PORT=3095

# ADMIN SECRET untuk /memex (wajib, minimal 16 karakter). Tanpa ini semua perubahan admin ditolak.
# Buat yang acak, misalnya: openssl rand -hex 24
ADMIN_SECRET=""
